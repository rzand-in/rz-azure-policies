# Set the definition
definition=cccc23c7-8427-4f53-ad12-b6a63eb452b3

# Set the scope to the PolicyLab resource group used in Lab1
scope=$(az group show --name 'PolicyLab' --output tsv --query id)
scope=/providers/Microsoft.Management/managementGroups/rzand-li

# Set the Policy Parameter (JSON format)
policyparam='{ "listOfAllowedSKUs": { "value": ["Standard_D2s_v3", "Standard_D4s_v3", "Standard_DS1_v2", "Standard_DS2_v2"]}}'

# Create the Policy Assignment
az policy assignment create --name 'Allowed Virtual Machine SKUs' --display-name 'Allowed Virtual Machine SKUs' --scope $scope --policy $definition --params "$policyparam" --output jsonc
# name can only be 24 chars
az policy assignment create --name 'Allowed VM SKUs' \
  --display-name 'Allowed Virtual Machine SKUs' \
  --scope $scope \
  --policy $definition \
  --params "$policyparam" \
  --output jsonc

N.B. reccomendation from https://www.azurecitadel.com/policy/basics/dine/ :
Our recommendation would be to always assign initiatives, even if it contains only one policy. If you modify that initiative, adding, removing or modifying the constituent policies, then they will be auto-assigned to the correct scope.

The Azure Policy VS Code extension relies on a deprecated extension and is better to avoid it. Use bicep extension instead

